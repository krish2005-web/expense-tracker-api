# Neon PostgreSQL connection (use the connection string from Neon Console > Connect).
# Keep the +psycopg driver and sslmode=require. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Generate separate random values for these two secrets:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_JWT_SECRET
OTP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_OTP_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Only required if you start the optional local PostgreSQL profile:
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_DATABASE_PASSWORD

# Optional dedicated test database. Never point this at your real Neon production database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_TEST_PASSWORD@localhost:5433/expense_tracker_test_db
